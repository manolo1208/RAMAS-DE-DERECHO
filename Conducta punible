/* ============================================================
   5. TALLER · RENDER
   ============================================================ */
const tabsEl = document.getElementById('caseTabs');
const outputEl = document.getElementById('simOutput');

CASOS.forEach((c, index) => {
  const btn = document.createElement('button');
  btn.className = 'case-tab';
  btn.type = 'button';
  btn.textContent = c.tab;
  btn.setAttribute('aria-pressed', index === 0 ? 'true' : 'false');
  btn.addEventListener('click', () => render Caso(c, btn));
  tabsEl.appendChild(btn);
});

function renderCaso(caso, btn) {
  [...tabsEl.children].forEach(b => b.setAttribute('aria-pressed','false'));
  btn.setAttribute('aria-pressed','true');

  const filtrosHTML = caso.filtros.map((f, i) => {
    const e = ESTADOS[f.estado];
    return `
      <div class="gate ${e.cls}">
        <div class="gate-index">${String(i+1).padStart(2,'0')}</div>
        <div class="gate-body">
          <div class="gate-top">
            <h4>${f.titulo}</h4>
            <span class="pill ${e.cls}">${e.label}</span>
          </div>
          <p>${f.texto}</p>
          <span class="gate-norma">ARTÍCULO ${f.art} · CÓDIGO PENAL</span>
        </div>
      </div>`;
  }).join('');

  outputEl.innerHTML = `
    <div class="case-facts">
      <span class="label">Hechos del escenario</span>
      <p>${caso.hechos}</p>
    </div>

    <div class="gates animate">${filtrosHTML}</div>

    <div class="verdict">
      <span class="label">Conclusión del análisis</span>
      <p>${caso.veredicto}</p>
    </div>

    <div class="contrast">
      <div class="contrast-box old">
        <h5>La lectura ingenua</h5>
        <p>${caso.contraste.old}</p>
      </div>
      <div class="contrast-box new">
        <h5>La lectura garantista</h5>
        <p>${caso.contraste.new}</p>
      </div>
    </div>
  `;

  // Reinicia la animación en cada cambio
  const gates = outputEl.querySelector('.gates');
  gates.classList.remove('animate');
  void gates.offsetWidth;
  gates.classList.add('animate');
}

// Corrección del nombre de la función en los listeners
[...tabsEl.children].forEach((btn, i) => {
  btn.onclick = () => renderCaso(CASOS[i], btn);
});

renderCaso(CASOS[0], tabsEl.children[0]);
</script>
