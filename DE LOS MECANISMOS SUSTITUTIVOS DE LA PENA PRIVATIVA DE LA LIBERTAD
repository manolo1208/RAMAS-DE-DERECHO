  toTop.classList.toggle('show', h.scrollTop > 700);
}
window.addEventListener('scroll', onScroll, { passive:true });
window.addEventListener('resize', onScroll);
onScroll();

toTop.addEventListener('click', () => window.scrollTo({ top:0, behavior:'smooth' }));

/* ============================================================
   3. REVELADO + NAVEGACIÓN ACTIVA
   ============================================================ */
if ('IntersectionObserver' in window){
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting){
        entry.target.classList.add('in');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: .08 });

  $$('.reveal').forEach(el => revealObserver.observe(el));

  const navLinks = $$('.site-nav a');
  const sections = navLinks.map(a => $(a.getAttribute('href'))).filter(Boolean);

  const navObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting){
        navLinks.forEach(a => {
          a.classList.toggle('active', a.getAttribute('href') === '#' + entry.target.id);
        });
      }
    });
  }, { rootMargin:'-20% 0px -65% 0px', threshold:0 });

  sections.forEach(s => navObserver.observe(s));
} else {
  $$('.reveal').forEach(el => el.classList.add('in'));
}

/* ============================================================
   4. LENTES DE LECTURA
   ============================================================ */
const lensButtons = $$('[data-lens-btn]');

function setLens(lens){
  document.body.setAttribute('data-lens', lens);
  lensButtons.forEach(btn => {
    btn.setAttribute('aria-pressed', String(btn.dataset.lensBtn === lens));
  });
}

lensButtons.forEach(btn => {
  btn.addEventListener('click', () => setLens(btn.dataset.lensBtn));
});

$$('[data-apply]').forEach(btn => {
  btn.addEventListener('click', () => {
    setLens(btn.dataset.apply);
    $('#articulos').scrollIntoView({ behavior:'smooth' });
    showToast('Lente activado: ' + btn.dataset.apply);
  });
});

/* ============================================================
   5. BUSCADOR
   ============================================================ */
const searchInput = $('#searchInput');
const searchClear = $('#searchClear');
const readerCount = $('#readerCount');
const emptyState  = $('#emptyState');
const articles    = $$('.lexeme');

// Índice de búsqueda precalculado
const index = articles.map(article => ({
  el: article,
  text: normalize(article.textContent + ' ' + (article.dataset.cita || ''))
}));

let searchTimer;

function runSearch(){
  const q = normalize(searchInput.value.trim());
  searchClear.hidden = !q;
  let visible = 0;

  index.forEach(item => {
    const match = !q || item.text.includes(q);
    item.el.style.display = match ? '' : 'none';
    if (match) visible++;
  });

  readerCount.textContent = visible + ' / ' + articles.length + ' núcleos';
  emptyState.classList.toggle('show', visible === 0);
}

searchInput.addEventListener('input', () => {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(runSearch, 160);
});

searchClear.addEventListener('click', () => {
  searchInput.value = '';
  runSearch();
  searchInput.focus();
});

/* ============================================================
   6. EXPANSIÓN DE NORMATIVA
   ============================================================ */
const expandBtn = $('#expandAll');
const norms = $$('.norm');

expandBtn.addEventListener('click', () => {
  const shouldOpen = norms.some(n => !n.open);
  norms.forEach(n => { n.open = shouldOpen; });
  expandBtn.textContent = shouldOpen ? 'Contraer toda la normativa' : 'Expandir toda la normativa';
});

norms.forEach(n => {
  n.addEventListener('toggle', () => {
    const allOpen = norms.every(x => x.open);
    const allClosed = norms.every(x => !x.open);
    expandBtn.textContent = allOpen ? 'Contraer toda la normativa' : 'Expandir toda la normativa';
  });
});

/* ============================================================
   7. COPIAR CITA + TOAST
   ============================================================ */
const toast = $('#toast');
let toastTimer;

function showToast(message){
  toast.textContent = message;
  toast.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
}

async function copyText(text){
  if (navigator.clipboard && window.isSecureContext){
    await navigator.clipboard.writeText(text);
    return;
  }
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  const ok = document.execCommand('copy');
  document.body.removeChild(ta);
  if (!ok) throw new Error('No se pudo copiar');
}

$$('[data-copy]').forEach(btn => {
  btn.addEventListener('click', async () => {
    const cita = btn.closest('.lexeme').dataset.cita;
    try {
      await copyText(cita);
      showToast('Cita copiada al portapapeles');
      btn.textContent = '✓ Copiada';
      setTimeout(() => { btn.textContent = 'Copiar cita'; }, 2200);
    } catch(e){
      showToast('No se pudo copiar. Selecciona el texto normativo.');
    }
  });
});

/* ============================================================
   8. IMPRESIÓN
   ============================================================ */
$('#printBtn').addEventListener('click', () => window.print());

let openedForPrint = [];
window.addEventListener('beforeprint', () => {
  openedForPrint = norms.filter(n => n.open);
  norms.forEach(n => { n.open = true; });
});
window.addEventListener('afterprint', () => {
  norms.forEach(n => { n.open = openedForPrint.includes(n); });
});

/* ============================================================
   9. ATAJOS
   ============================================================ */
document.addEventListener('keydown', (e) => {
  // "/" enfoca el buscador
  if (e.key === '/' && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){
    e.preventDefault();
    searchInput.focus();
  }
  // Esc limpia la búsqueda
  if (e.key === 'Escape' && document.activeElement === searchInput){
    searchInput.value = '';
    runSearch();
    searchInput.blur();
  }
});
</script>
</body>
</html>
