  .pregunta.answered { border-left-color: var(--secondary); }
  .pregunta-num { display: inline-block; background: var(--accent); color: white; padding: 0.2rem 0.7rem; border-radius: 12px; font-size: 0.85rem; margin-right: 0.5rem; }
  .pregunta-tipo { display: inline-block; background: var(--secondary); color: var(--dark); padding: 0.2rem 0.7rem; border-radius: 12px; font-size: 0.75rem; margin-left: 0.3rem; font-weight: bold; }
  .pregunta p { font-weight: bold; color: var(--primary); margin: 0.8rem 0; text-align: left; }
  .opciones { display: flex; flex-direction: column; gap: 0.5rem; }
  .opcion { padding: 0.7rem 1rem; background: #ecfdf5; border: 2px solid transparent; border-radius: 6px; cursor: pointer; transition: all 0.2s; position: relative; }
  .opcion:hover:not(.disabled) { border-color: var(--accent); background: #d1fae5; }
  .opcion.disabled { cursor: not-allowed; opacity: 0.85; }
  .opcion.correcta { background: #d1fae5; border-color: var(--success); color: var(--success); font-weight: bold; }
  .opcion.incorrecta { background: #fee2e2; border-color: var(--danger); color: var(--danger); }
  .opcion.correcta::after { content: ' ✓'; font-weight: bold; }
  .opcion.incorrecta::after { content: ' ✗'; font-weight: bold; }
  .explicacion { margin-top: 0.8rem; padding: 0.8rem; background: #ecfdf5; border-left: 3px solid var(--accent); border-radius: 0 6px 6px 0; font-size: 0.9rem; display: none; font-style: italic; }
  .explicacion.visible { display: block; animation: fadeIn 0.3s ease; }
  .resultado-final { margin-top: 2rem; padding: 2rem; background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); color: white; border-radius: 12px; text-align: center; display: none; }
  .resultado-final.visible { display: block; animation: fadeIn 0.5s ease; }
  .resultado-final h3 { color: var(--secondary); font-size: 2rem; margin-bottom: 1rem; }
  .puntaje-final { font-size: 3rem; font-weight: bold; color: var(--secondary); margin: 1rem 0; }
  .desglose-temas { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1.5rem; text-align: left; }
  .desglose-item { background: rgba(255,255,255,0.1); padding: 1rem; border-radius: 8px; }
  .desglose-item h4 { color: var(--secondary); margin-bottom: 0.5rem; font-size: 1rem; }
  .mini-bar { background: rgba(255,255,255,0.2); height: 8px; border-radius: 4px; overflow: hidden; margin-top: 0.5rem; }
  .mini-bar-fill { background: var(--secondary); height: 100%; transition: width 0.6s ease; }
  button { background: var(--primary); color: white; border: none; padding: 0.8rem 1.5rem; border-radius: 6px; cursor: pointer; font-size: 1rem; margin-top: 1rem; transition: all 0.3s; }
  button:hover { background: var(--secondary); color: var(--dark); transform: translateY(-2px); }
  .btn-reset { background: var(--danger); margin-left: 0.5rem; }
  .btn-reset:hover { background: #991b1b; color: white; }
  .acordeon-item { margin-bottom: 0.5rem; border: 1px solid #ddd; border-radius: 6px; overflow: hidden; }
  .acordeon-header { background: var(--accent); color: white; padding: 1rem; cursor: pointer; font-weight: bold; display: flex; justify-content: space-between; align-items: center; transition: background 0.3s; }
  .acordeon-header:hover { background: var(--primary); }
  .acordeon-content { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; background: white; }
  .acordeon-content.active { max-height: 2000px; padding: 1rem; }
  .flecha { transition: transform 0.3s; }
  .acordeon-header.active .flecha { transform: rotate(180deg); }
  footer { background: var(--dark); color: var(--light); text-align: center; padding: 2rem 1rem; margin-top: 2rem; }
  footer p { margin-bottom: 0.5rem; }
  @media (max-width: 768px) { header h1 { font-size: 1.8rem; } section { padding: 1.2rem; } section h2 { font-size: 1.5rem; } nav a { font-size: 0.6rem; padding: 0.3rem 0.4rem; } .quiz-tab { font-size: 0.6rem; padding: 0.3rem 0.4rem; } table { font-size: 0.8rem; } }
</style>
