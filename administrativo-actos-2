<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Teoría General del Acto Administrativo II - Derecho Administrativo</title>
<style>
  :root {
    --primary: #065f46;
    --secondary: #10b981;
    --accent: #047857;
    --light: #ecfdf5;
    --dark: #064e3b;
    --success: #059669;
    --warning: #d97706;
    --danger: #dc2626;
    --card-bg: #ffffff;
    --shadow: 0 4px 15px rgba(0,0,0,0.08);
    --shadow-hover: 0 8px 25px rgba(0,0,0,0.15);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Georgia', 'Times New Roman', serif; background: var(--light); color: var(--dark); line-height: 1.7; }
  header { background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%); color: white; padding: 2rem 1rem; text-align: center; box-shadow: var(--shadow); position: relative; overflow: hidden; }
  header::before { content: '📋'; position: absolute; font-size: 15rem; opacity: 0.05; top: -30px; right: -30px; }
  header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; letter-spacing: 2px; }
  header p { font-size: 1.1rem; opacity: 0.9; font-style: italic; }
  nav { background: var(--dark); position: sticky; top: 0; z-index: 100; box-shadow: var(--shadow); }
  nav ul { display: flex; justify-content: center; flex-wrap: wrap; list-style: none; padding: 0.5rem; }
  nav a { color: var(--light); text-decoration: none; padding: 0.7rem 1rem; margin: 0.2rem; border-radius: 5px; font-size: 0.7rem; transition: all 0.3s; display: block; }
  nav a:hover { background: var(--secondary); color: var(--dark); transform: translateY(-2px); }
  main { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  section { background: var(--card-bg); margin-bottom: 2.5rem; padding: 2rem; border-radius: 12px; box-shadow: var(--shadow); border-left: 5px solid var(--secondary); scroll-margin-top: 80px; }
  section h2 { color: var(--primary); font-size: 2rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--secondary); }
  section h3 { color: var(--accent); font-size: 1.4rem; margin: 1.5rem 0 0.8rem; }
  section h4 { color: var(--primary); font-size: 1.15rem; margin: 1rem 0 0.5rem; }
  p { margin-bottom: 1rem; text-align: justify; }
  .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.2rem; margin: 1.5rem 0; }
  .card { background: linear-gradient(135deg, #fff 0%, #ecfdf5 100%); border: 2px solid var(--secondary); border-radius: 10px; padding: 1.2rem; transition: all 0.3s; cursor: pointer; position: relative; }
  .card:hover { transform: translateY(-5px); box-shadow: var(--shadow-hover); border-color: var(--primary); }
  .card .icon { font-size: 2.5rem; text-align: center; margin-bottom: 0.5rem; }
  .card h4 { text-align: center; color: var(--primary); margin-bottom: 0.5rem; }
  .card .detail { display: none; margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px dashed var(--secondary); font-size: 0.95rem; }
  .card.active .detail { display: block; }
  .card .hint { text-align: center; color: var(--accent); font-size: 0.85rem; font-style: italic; }
  .mapa-container { background: #ecfdf5; border: 2px dashed var(--secondary); border-radius: 10px; padding: 1.5rem; margin: 1.5rem 0; overflow-x: auto; }
  .mapa { display: flex; flex-direction: column; align-items: center; min-width: 600px; }
  .nodo { background: var(--primary); color: white; padding: 0.8rem 1.5rem; border-radius: 25px; font-weight: bold; text-align: center; min-width: 180px; box-shadow: var(--shadow); }
  .nodo.central { background: linear-gradient(135deg, var(--secondary), #34d399); color: var(--dark); font-size: 1.2rem; padding: 1rem 2rem; }
  .nodo.sub { background: var(--accent); font-size: 0.95rem; }
  .linea { width: 3px; height: 25px; background: var(--secondary); }
  .linea-h { height: 3px; background: var(--secondary); width: 80%; max-width: 900px; margin: 0 auto; }
  .rama { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 1rem; width: 100%; margin-top: 1rem; }
  .rama-item { display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 140px; }
  .ejemplo { background: #ecfdf5; border-left: 4px solid var(--success); padding: 1rem 1.2rem; margin: 1rem 0; border-radius: 0 8px 8px 0; }
  .ejemplo strong { color: var(--success); }
  .alerta { background: #fffbeb; border-left: 4px solid var(--warning); padding: 1rem 1.2rem; margin: 1rem 0; border-radius: 0 8px 8px 0; }
  .alerta strong { color: var(--warning); }
  .cita { background: #ecfdf5; border-left: 4px solid var(--accent); padding: 1rem 1.2rem; margin: 1rem 0; border-radius: 0 8px 8px 0; font-style: italic; color: var(--primary); }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; background: white; border-radius: 8px; overflow: hidden; box-shadow: var(--shadow); font-size: 0.9rem; }
  th { background: var(--primary); color: white; padding: 0.8rem; text-align: left; }
  td { padding: 0.8rem; border-bottom: 1px solid #eee; }
  tr:nth-child(even) { background: #ecfdf5; }
  tr:hover { background: #d1fae5; }
  .quiz-container { background: linear-gradient(135deg, #ecfdf5 0%, #fff 100%); padding: 1.5rem; border-radius: 10px; border: 2px solid var(--accent); }
  .quiz-header { background: var(--primary); color: white; padding: 1.2rem; border-radius: 8px; margin-bottom: 1.5rem; text-align: center; }
  .quiz-header h3 { color: white; margin: 0 0 0.5rem 0; }
  .progress-bar { background: rgba(255,255,255,0.2); height: 10px; border-radius: 5px; overflow: hidden; margin-top: 0.5rem; }
  .progress-fill { background: var(--secondary); height: 100%; width: 0%; transition: width 0.4s ease; }
  .quiz-stats { display: flex; justify-content: space-around; margin-top: 1rem; flex-wrap: wrap; gap: 0.5rem; }
  .stat { background: rgba(255,255,255,0.1); padding: 0.5rem 1rem; border-radius: 5px; font-size: 0.9rem; }
  .stat strong { color: var(--secondary); }
  .quiz-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; padding: 0.5rem; background: #d1fae5; border-radius: 8px; }
